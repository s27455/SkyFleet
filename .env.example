# Docker Compose settings. Copy to `.env` (same folder) and fill in. Never commit `.env`.
# The database connection is configured automatically inside Docker; nothing to set for it.

# Required for the map: a PUBLIC Mapbox token (starts with "pk."), from https://account.mapbox.com.
# It is bundled into the browser, which is why only a public token belongs here (never "sk.").
# After changing it, rebuild: docker compose up --build
VITE_MAPBOX_TOKEN=

# --- Optional: AI Copilot (backend only, OFF by default; the app works fully without it) ---
# SKYFLEET_AI_ENABLED=true
# ANTHROPIC_API_KEY=
# Operator token typed into the Copilot panel; at least 32 characters.
# SKYFLEET_AI_ACCESS_TOKEN=

# --- Optional: host ports, if the defaults are already in use ---
# FRONTEND_PORT=5173
# API_PORT=8000
# DB_PORT=55432
