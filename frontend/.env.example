# Copy to `.env.local` and adjust. Never commit real values.
# Everything prefixed with VITE_ is bundled into the browser — never put secrets here.

VITE_API_BASE_URL=http://127.0.0.1:8000

# A PUBLIC Mapbox token (starts with "pk."), restricted to your app's URLs
# (e.g. http://localhost:5173). Never use a secret "sk." token here.
VITE_MAPBOX_TOKEN=
