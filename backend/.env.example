# Copy to `.env` and adjust. Never commit `.env`.

APP_ENV=development
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173
# Seconds between Simulation Worker ticks.
SIM_TICK_SECONDS=1.0
LOG_LEVEL=INFO

# Added in Phase 3 (persistence), matching docker-compose.yml:
# PostgreSQL from docker-compose.yml (host port 55432; also the default if unset).
DATABASE_URL=postgresql+psycopg://skyfleet:skyfleet@localhost:55432/skyfleet

# AI Copilot — disabled by default
SKYFLEET_AI_ENABLED=false
# ANTHROPIC_API_KEY=
# SKYFLEET_AI_MODEL=claude-haiku-5-5