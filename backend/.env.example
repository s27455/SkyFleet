# Copy to `.env` and adjust. Never commit `.env`.

APP_ENV=development
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173
# Seconds between Simulation Worker ticks.
SIM_TICK_SECONDS=1.0
LOG_LEVEL=INFO

